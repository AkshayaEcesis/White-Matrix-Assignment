# API base path. Keep "/api/v1" - the Vite dev proxy (local) and Vercel rewrites (production)
# forward it to Django, so the refresh-token cookie stays first-party.
VITE_API_BASE_URL=/api/v1
# Local dev only: where the Vite proxy forwards /api (default http://localhost:8000)
VITE_DEV_API_PROXY=http://localhost:8000
# Show the demo-account helper on the login page (set to false to hide)
VITE_SHOW_DEMO_ACCOUNTS=true
