# ---------------------------------------------------------------------------
# CM Kerala Grievance Portal (recruitment prototype) - environment template
# backend/.env  <- the BACKEND section    frontend/.env <- see frontend/.env.example
# NEVER commit real secrets. All values below are placeholders.
# ---------------------------------------------------------------------------

# ===== backend/.env =====
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Optional: move the Django admin to a non-default path in production
DJANGO_ADMIN_URL=admin/

# PostgreSQL. URL-encode special characters in the password (@ -> %40, # -> %23)
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/cm_kerala
DATABASE_SSL_REQUIRE=False

# Only needed if the frontend calls the API cross-origin (the default setup uses a same-origin proxy)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# JWT: access token in memory (minutes), refresh token in HttpOnly cookie (days)
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=1
JWT_COOKIE_SAMESITE=Strict
# JWT_COOKIE_SECURE defaults to True when DJANGO_DEBUG=False

# Google Gemini (server-side only; never exposed to the browser)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=20

# Uploads
MAX_UPLOAD_SIZE_MB=4

# Private S3-compatible bucket for attachments in production (leave empty to use local disk)
AWS_STORAGE_BUCKET_NAME=
AWS_S3_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Password for the fictional demo accounts created by `python manage.py seed_demo`
DEMO_PASSWORD=Demo@2026
